rules_version = '2';
// 콕 교무수첩 보안 규칙 (rules/firestore.rules 초안을 그대로 가져와 ssug-gyomu에 배포, 2026-10-19)
// 원칙: 기본 거부 · users/{uid} 본인만 · 컬렉션마다 허용 필드 목록과 형식·길이 검사 · 와일드카드 쓰기 없음
// 건강·학폭·민원 기록은 클라우드에 두지 않는다(앱이 이 기기에만 저장). 규칙에서도 대표 낱말이 든 글은 한 번 더 막는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function d() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(k, max) { return !(k in d()) || str(d()[k], 0, max); }
    function optInt(k, min, max) { return !(k in d()) || (d()[k] is int && d()[k] >= min && d()[k] <= max); }
    function optBool(k) { return !(k in d()) || d()[k] is bool; }
    function optTs(k) { return !(k in d()) || d()[k] is timestamp; }
    function leap(y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }
    function mdays(y, m) { return m == 2 ? (leap(y) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31); }
    function ymd(v) {
      return v is string && v.matches('^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(v[8:10]) <= mdays(int(v[0:4]), int(v[5:7]));
    }
    function hm(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    // 시각이 서버가 받은 때보다 5분 넘게 앞서면 거절합니다(시계가 틀린 기기의 미래 시각이 이후 수정을 이기지 않게, PR #57 검수).
    // v46은 serverTimestamp(= request.time)를 써서 그대로 통과합니다.
    function notAhead(v) { return v is timestamp && v <= request.time + duration.value(5, 'm'); }
    // ── 할 일 고친 시각(PR #57) ──
    // v47은 hlc(= updatedAt, 고친 시각)를 함께 씁니다. v46은 hlc를 모르고 updatedAt을 올린 시각으로 씁니다.
    function v47Todo() { return 'hlc' in d() && 'updatedAt' in d() && d().hlc == d().updatedAt; }
    // 클라우드 쪽 시각이 확실한가(v47이 잰 시각으로 쓴 문서).
    function sureDoc() { return resource != null && 'hlc' in resource.data && !('u' in resource.data && resource.data.u == true); }
    function todoTomb(tid) { return /databases/$(database)/documents/users/$(request.auth.uid)/tombs/$('todos-' + tid); }
    function todoClockOk(tid) {
      return (
          // v47이 한 번이라도 쓴 문서는 v47만 고칩니다(v46의 늦은 업로드가 나중 수정을 덮지 않게). v46 기기는 로컬에 그대로 두고 새 판에서 맞춥니다.
          // hlc가 있으면 늘 updatedAt과 같아야 합니다(v47이 쓴 것). v46이 v47 문서에 merge로 쓰면 hlc만 남아 달라지므로 거절됩니다.
          !('hlc' in d()) || v47Todo()
        ) && (
          // v47이 쓴 문서를 바꾸는 쓰기는 늘 새 updatedAt(=hlc)을 함께 씁니다. updatedAt 없이 merge로 다른 칸만 바꾸면
          // 옛 hlc·updatedAt이 그대로 남아 v47 쓰기처럼 보이므로 거절합니다(PR #57 r3 검수 규칙 허점). 아무것도 안 바뀐 쓰기는 받습니다.
          resource == null || !('hlc' in resource.data)
            || d().diff(resource.data).affectedKeys().size() == 0
            || d().diff(resource.data).affectedKeys().hasAny(['updatedAt'])
        ) && (
          // 시각이 확실한 문서는 더 이른 시각으로 덮지 않습니다. 불확실한 문서(u)는 v47이 충돌 사본을 남기고 덮습니다.
          !sureDoc() || !v47Todo() || d().hlc >= resource.data.hlc
        ) && (
          // 묘비가 있으면 그보다 늦게 고친 v47 쓰기만 받습니다(v46의 되살리기 거절). 거절된 v46 자료는 새 판에서 충돌 사본으로 올라갑니다.
          !exists(todoTomb(tid)) || (v47Todo() && d().hlc > get(todoTomb(tid)).data.at)
        );
    }
    function id(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,40}$'); }
    // 민감 낱말 2차 차단. 본문은 src/lib/sensitive.js 의 rulesSafeTextBody()와 같아야 합니다.
    function safeText(v) { return !v.matches('(?s).*(학교폭력|학폭|민원|투약|복약|알레르기|건강|보건|분리 ?급식).*'); }
    // ── 기기 설정(settings/device) 검사 ──
    // 글자 목록: 모두 글자이고(join 이 아니면 거절) 각 칸이 형식에 맞고 개수가 max 이하
    // full: 쉼표로 이은 전체에 맞출 정규식(글자 그대로 적어 계산을 줄입니다).
    // w: 한 칸 글자 수(날짜 10, 시각 5). 이은 길이가 n*(w+1)-1 이면 한 칸에 쉼표로 여러 값을 숨기지 못합니다.
    function joinedOk(l, max, full, w) {
      return l is list && l.size() <= max && (l.size() == 0 || joinedStrOk(l.join(','), l.size(), full, w));
    }
    function joinedStrOk(j, n, full, w) { return j.size() == n * (w + 1) - 1 && j.matches(full); }
    // 칸 잠금은 'mon-3,tue-10' 처럼 쉼표로 이은 글자 하나(50칸까지).
    function cellLocksOk(v) { return v is string && v.size() <= 350 && v.matches('^(((mon|tue|wed|thu|fri)-([1-9]|10))(,((mon|tue|wed|thu|fri)-([1-9]|10))){0,49})?$'); }
    function atOk(v) { return v is int && v >= 0; }
    // work(출퇴근 시각 칸 시각)는 PR #53에서 더했습니다. 예전 앱은 이 칸 없이 올리므로 없어도 받습니다.
    function setAtsOk(a) {
      return a is map && a.keys().hasAll(['period', 'extra', 'periodStarts', 'ttEdited', 'academic'])
        && a.keys().hasOnly(['period', 'extra', 'periodStarts', 'ttEdited', 'academic', 'work'])
        && atOk(a.period) && atOk(a.extra) && atOk(a.periodStarts) && atOk(a.ttEdited) && atOk(a.academic)
        && (!('work' in a) || atOk(a.work));
    }
    // 숫자 목록은 '45,45,40' 처럼 쉼표로 이은 글자 하나로 받습니다(반복문 없이 정규식 한 번으로 10개까지 검사).
    function csvOk(v, full) { return v is string && v.size() <= 40 && v.matches(full); }
    function subjOk(m, k) { return !(k in m) || (str(m[k], 0, 20) && safeText(m[k])); }
    // 9·10교시 과목: 'mon-p9=방과후|tue-p10=보충' 처럼 글자 하나(20칸까지, 값은 20자 이하, 민감 낱말 없음, 전체 1000자 이하).
    // 값 안의 '%'·'|'·'=' 는 %25·%7C·%3D 로 이스케이프합니다(이스케이프 하나가 한 글자).
    function extraOk(e) {
      return e is string && e.size() <= 1000
        && e.matches('^((mon|tue|wed|thu|fri)-[ps](9|10)=([^|=%]|%(25|7C|3D)){0,20}([|](mon|tue|wed|thu|fri)-[ps](9|10)=([^|=%]|%(25|7C|3D)){0,20}){0,19})?$')
        && safeText(e);
    }
    function hmOrEmpty(v) { return v is string && (v == '' || hm(v)); }
    function periodLocalOk(p) {
      return p is map
        && p.keys().hasAll(['level', 'count', 'lengths', 'extraStarts', 'locks', 'cellLocks', 'workStart', 'workEnd', 'extra'])
        && p.keys().hasOnly(['level', 'count', 'lengths', 'extraStarts', 'locks', 'cellLocks', 'workStart', 'workEnd', 'extra'])
        && p.level in ['초', '중', '고']
        && p.count is int && p.count >= 1 && p.count <= 10
        && csvOk(p.lengths, '^(([0-9]|[1-9][0-9]|1[01][0-9]|120)(,([0-9]|[1-9][0-9]|1[01][0-9]|120)){0,9})?$')
        && csvOk(p.locks, '^(([1-9]|10)(,([1-9]|10)){0,9})?$')
        && joinedOk(p.extraStarts, 2, '^(([01][0-9]|2[0-3]):[0-5][0-9])(,(([01][0-9]|2[0-3]):[0-5][0-9]))*$', 5)
        && cellLocksOk(p.cellLocks)
        && hmOrEmpty(p.workStart) && hmOrEmpty(p.workEnd)
        && extraOk(p.extra);
    }
    // 학기 날짜 네 칸은 '|'로 이어 정규식 한 번에 봅니다(없는 칸은 빈 글자).
    function acadYearOk(r) {
      return r is map
        && r.keys().hasOnly(['firstStart', 'firstEnd', 'secondStart', 'secondEnd', 'offDays'])
        && [r.get('firstStart', ''), r.get('firstEnd', ''), r.get('secondStart', ''), r.get('secondEnd', '')].join('|').matches('^(20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?[|](20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?[|](20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?[|](20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?$')
        && joinedOk(r.get('offDays', []), 40, '^(20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))(,(20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])))*$', 10);
    }
    // 학년도는 4개까지라 앞에서부터 네 칸만 봅니다(반복문 대신).
    function acadAt(a, i) { return a.size() <= i || acadKeyOk(a, a.keys()[i]); }
    function acadKeyOk(a, y) { return y.matches('^20(2[4-9]|3[0-5])$') && acadYearOk(a[y]); }
    function academicOk(a) {
      return a is map && a.size() <= 4
        && acadAt(a, 0) && acadAt(a, 1) && acadAt(a, 2) && acadAt(a, 3);
    }
    // 앱은 늘 모든 칸을 함께 올립니다. 칸을 모두 요구하면 'in' 검사가 줄어 규칙 계산 한도(1000) 안에 듭니다.
    function settingsOk(v) {
      return v.keys().hasAll(['at', 'ats', 'periodLocal', 'periodStarts', 'ttEdited', 'academic'])
        && v.keys().hasOnly(['at', 'ats', 'periodLocal', 'periodStarts', 'ttEdited', 'academic', 'updatedAt'])
        && v.at is int && v.at > 0 && v.at <= 4102444800000
        && setAtsOk(v.ats)
        && periodLocalOk(v.periodLocal)
        && joinedOk(v.periodStarts, 8, '^(([01][0-9]|2[0-3]):[0-5][0-9])(,(([01][0-9]|2[0-3]):[0-5][0-9]))*$', 5)
        && joinedOk(v.ttEdited, 400, '^(20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))(,(20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])))*$', 10)
        && academicOk(v.academic)
        && (!('updatedAt' in v) || v.updatedAt is timestamp);
    }
    // 태그: 10개까지, 각 1~12자, 줄바꿈 금지
    function tagsOk(t) {
      return t is list && t.size() <= 10
        && (t.size() == 0 || (t.join('\n').matches('^[^\n]{1,12}(\n[^\n]{1,12})*$') && t.join('\n').split('\n').size() == t.size()))
        && (t.size() <= 0 || t[0] is string) && (t.size() <= 1 || t[1] is string) && (t.size() <= 2 || t[2] is string)
        && (t.size() <= 3 || t[3] is string) && (t.size() <= 4 || t[4] is string) && (t.size() <= 5 || t[5] is string)
        && (t.size() <= 6 || t[6] is string) && (t.size() <= 7 || t[7] is string) && (t.size() <= 8 || t[8] is string)
        && (t.size() <= 9 || t[9] is string);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && d().keys().hasOnly(['displayName', 'className', 'schoolYear', 'classSize', 'theme', 'periodStart',
                               'migratedAt', 'migrationVersion', 'createdAt', 'updatedAt'])
        && optStr('displayName', 40) && optStr('className', 30)
        && optInt('schoolYear', 2024, 2099) && optInt('classSize', 0, 50)
        && (!('theme' in d()) || d().theme in ['system', 'light', 'dark'])
        && (!('periodStart' in d()) || hm(d().periodStart))
        && optTs('migratedAt') && optInt('migrationVersion', 1, 100)
        && optTs('createdAt') && optTs('updatedAt');

      // 학생: 번호·이름만 필수. 생일은 연도 없이 MM-DD (생일 축하용, 개인정보 최소화)
      match /students/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(sid)
          && d().keys().hasAll(['no', 'name'])
          && d().keys().hasOnly(['no', 'name', 'sex', 'birthday', 'active', 'memo', 'createdAt', 'updatedAt'])
          && d().no is int && d().no >= 1 && d().no <= 50
          && str(d().name, 1, 20)
          && (!('sex' in d()) || d().sex in ['m', 'f', ''])
          && (!('birthday' in d()) || (d().birthday is string && d().birthday.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
          && optBool('active') && optStr('memo', 200) && (!('memo' in d()) || safeText(d().memo))
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 출결: 예외만 저장(문서 없음 = 출석). 문서 id = 날짜_학생id
      match /attendance/{aid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && aid.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]_[A-Za-z0-9_-]{1,40}$')
          && d().keys().hasAll(['date', 'sid', 'status'])
          && d().keys().hasOnly(['date', 'sid', 'status', 'reason', 'period', 'paper', 'note', 'updatedAt'])
          && ymd(d().date) && id(d().sid) && aid == d().date + '_' + d().sid
          && d().status in ['absent', 'late', 'early', 'out']
          && (!('reason' in d()) || d().reason in ['sick', 'unexcused', 'approved', 'other'])
          && optInt('period', 1, 8) && optBool('paper')
          && optStr('note', 100) && (!('note' in d()) || safeText(d().note))
          && optTs('updatedAt');
      }

      // 관찰·상담·보호자·칭찬 기록
      match /records/{rid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(rid)
          && d().keys().hasAll(['date', 'kind', 'text'])
          && d().keys().hasOnly(['date', 'kind', 'sid', 'text', 'tags', 'neis', 'follow', 'minutes', 'source', 'createdAt', 'updatedAt'])
          && ymd(d().date) && d().kind in ['observe', 'counsel', 'parent', 'praise']
          && (!('sid' in d()) || id(d().sid))
          && str(d().text, 1, 2000) && safeText(d().text)
          && (!('tags' in d()) || tagsOk(d().tags))
          && optBool('neis') && (!('follow' in d()) || ymd(d().follow))
          && optInt('minutes', 0, 600)
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 학급 일정
      match /events/{eid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(eid)
          && d().keys().hasAll(['date', 'title'])
          && d().keys().hasOnly(['date', 'end', 'time', 'endTime', 'title', 'kind', 'memo', 'source', 'createdAt', 'updatedAt'])
          && ymd(d().date) && (!('end' in d()) || (ymd(d().end) && d().end >= d().date))
          && (!('time' in d()) || hm(d().time))
          && (!('endTime' in d()) || hm(d().endTime))
          && str(d().title, 1, 60) && safeText(d().title)
          && (!('kind' in d()) || d().kind in ['class', 'school', 'holiday', 'mine'])
          && optStr('memo', 300) && (!('memo' in d()) || safeText(d().memo))
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 지운 할 일 표시(묘비): 다른 기기가 지운 할 일을 그보다 먼저 고친 기기가 되살리지 않게 지운 시각만 남깁니다.
      match /tombs/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && key.matches('^todos-[A-Za-z0-9_-]{1,40}$')
          && d().keys().hasAll(['k', 'at']) && d().keys().hasOnly(['k', 'at'])
          && d().k == 'todos' && notAhead(d().at);
      }

      // 할 일 (걷기 진행: got / of)
      match /todos/{tid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(tid)
          && d().keys().hasAll(['title', 'done'])
          && d().keys().hasOnly(['title', 'done', 'due', 'got', 'of', 'order', 'source', 'createdAt', 'updatedAt', 'doneAt', 'hlc', 'u'])
          && str(d().title, 1, 100) && safeText(d().title) && d().done is bool
          && (!('due' in d()) || ymd(d().due))
          && optInt('got', 0, 50) && optInt('of', 0, 50) && optInt('order', 0, 100000)
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt') && optTs('doneAt') && optTs('hlc')
          && (!('u' in d()) || d().u == true)
          && (!('updatedAt' in d()) || notAhead(d().updatedAt))
          && todoClockOk(tid);
      }

      // 정리함: 저장 때 빼 둔 할 일·일정. 민감 글은 앱이 올리지 않고 규칙에서도 한 번 더 막습니다.
      match /inbox/{iid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(iid)
          && d().keys().hasAll(['title', 'kind', 'source'])
          && d().keys().hasOnly(['title', 'kind', 'source', 'date', 'end', 'time', 'endTime', 'eventKind', 'memo', 'warning', 'updatedAt'])
          && str(d().title, 1, 100) && safeText(d().title)
          && d().kind in ['todo', 'event']
          && d().source in ['app', 'legacy', 'file']
          && (!('date' in d()) || ymd(d().date))
          && (!('end' in d()) || (ymd(d().end) && (!('date' in d()) || d().end >= d().date)))
          && (!('time' in d()) || hm(d().time))
          && (!('endTime' in d()) || hm(d().endTime))
          && (!('eventKind' in d()) || d().eventKind in ['class', 'school', 'holiday', 'mine'])
          && optStr('memo', 300) && (!('memo' in d()) || safeText(d().memo))
          && optStr('warning', 120) && (!('warning' in d()) || safeText(d().warning))
          && optTs('updatedAt');
      }

      // 메모·회의록(회의록은 '회의' 태그, 제목·참석자는 회의록만 씁니다. 본문은 회의록에 맞게 20000자까지)
      match /notes/{nid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(nid)
          && d().keys().hasAll(['text'])
          && d().keys().hasOnly(['text', 'title', 'attendees', 'date', 'tags', 'pinned', 'source', 'createdAt', 'updatedAt'])
          && str(d().text, 1, 20000) && safeText(d().text)
          && optStr('title', 60) && (!('title' in d()) || safeText(d().title))
          && optStr('attendees', 200) && (!('attendees' in d()) || safeText(d().attendees))
          && (!('date' in d()) || ymd(d().date)) && (!('tags' in d()) || tagsOk(d().tags))
          && optBool('pinned')
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 알림장: 문서 id = 날짜
      match /notices/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ymd(day)
          && d().keys().hasAll(['text'])
          && d().keys().hasOnly(['text', 'copiedAt', 'updatedAt'])
          && str(d().text, 0, 2000) && safeText(d().text)
          && optTs('copiedAt') && optTs('updatedAt');
      }

      // 시간표: 문서 id = 요일 mon~fri (기본표) 또는 날짜(그날만 바뀐 표)
      // 기기끼리 같이 쓰는 설정 한 문서(교시 길이·9·10교시·출퇴근·시작 시각·학사일정·그날 고친 날 표시).
      // 기기끼리 같이 쓰는 설정 한 문서. 칸마다 고친 시각(ats)을 두고 칸 단위로 합칩니다.
      // 안쪽 값도 다른 컬렉션처럼 형식·길이·민감 낱말을 서버에서 다시 막습니다.
      match /settings/{key} {
        allow read, delete: if isOwner(uid) && key == 'device';
        allow create, update: if isOwner(uid) && key == 'device' && settingsOk(request.resource.data);
      }
      match /timetable/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (key in ['mon', 'tue', 'wed', 'thu', 'fri'] || ymd(key))
          && d().keys().hasOnly(['p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8',
                                 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8',
                                 'p9', 'p10', 's9', 's10', 'updatedAt'])
          && subjOk(d(), 'p9') && subjOk(d(), 'p10') && subjOk(d(), 's9') && subjOk(d(), 's10')
          && optStr('p1', 20) && optStr('p2', 20) && optStr('p3', 20) && optStr('p4', 20)
          && optStr('p5', 20) && optStr('p6', 20) && optStr('p7', 20) && optStr('p8', 20)
          && optStr('s1', 20) && optStr('s2', 20) && optStr('s3', 20) && optStr('s4', 20)
          && optStr('s5', 20) && optStr('s6', 20) && optStr('s7', 20) && optStr('s8', 20)
          && optTs('updatedAt');
      }

      // 예전 교무수첩에서 새 구조로 못 옮긴 쪽을 글 그대로 보관(읽기 전용 보관함). 민감 쪽은 여기 오지 않음
      match /legacy/{lid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && lid.matches('^(p[0-9]{1,3}|list-[A-Za-z]{1,30}|board-[A-Za-z]{1,30})$')
          && d().keys().hasAll(['kind', 'raw', 'at'])
          && d().keys().hasOnly(['kind', 'raw', 'title', 'at'])
          && str(d().kind, 1, 30) && str(d().raw, 2, 200000) && safeText(d().raw)
          && optStr('title', 60) && d().at is timestamp;
        allow update: if false; // 보관본은 고치지 않음
      }

      // 옮기기·가져오기 이력: 몇 건을 언제 어디서 옮겼는지만
      match /imports/{iid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && iid.matches('^imp-[0-9a-z]{6,14}$')
          && d().keys().hasAll(['from', 'count', 'at'])
          && d().keys().hasOnly(['from', 'count', 'skipped', 'localOnly', 'at'])
          && d().from in ['legacy-local', 'legacy-cloud', 'json']
          && d().count is int && d().count >= 0 && d().count <= 50000
          && optInt('skipped', 0, 50000) && optInt('localOnly', 0, 50000)
          && d().at is timestamp;
        allow update: if false;
      }
      // 그 밖의 하위 컬렉션: 규칙 없음 = 거부
    }
    // users 밖 모든 경로: 규칙 없음 = 거부
  }
}
