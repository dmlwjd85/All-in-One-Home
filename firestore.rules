rules_version = '2';
// 쓱 교무수첩 보안 규칙 (rules/firestore.rules 초안을 그대로 가져와 ssug-gyomu에 배포, 2026-10-19)
// 원칙: 기본 거부 · users/{uid} 본인만 · 컬렉션마다 허용 필드 목록과 형식·길이 검사 · 와일드카드 쓰기 없음
// 건강·학폭·민원 기록은 클라우드에 두지 않는다(앱이 이 기기에만 저장). 규칙에서도 대표 낱말이 든 글은 한 번 더 막는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function d() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(k, max) { return !(k in d()) || str(d()[k], 0, max); }
    function optInt(k, min, max) { return !(k in d()) || (d()[k] is int && d()[k] >= min && d()[k] <= max); }
    function optBool(k) { return !(k in d()) || d()[k] is bool; }
    function optTs(k) { return !(k in d()) || d()[k] is timestamp; }
    function leap(y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }
    function mdays(y, m) { return m == 2 ? (leap(y) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31); }
    function ymd(v) {
      return v is string && v.matches('^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(v[8:10]) <= mdays(int(v[0:4]), int(v[5:7]));
    }
    function hm(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function id(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,40}$'); }
    // 민감 낱말 2차 차단(앱이 먼저 이 기기 전용으로 돌림). 오탐이 나면 앱이 '이 기기에만 저장'으로 안내
    function safeText(v) { return !v.matches('(?s).*(학교폭력|학폭|민원|투약|복약|알레르기|분리 ?급식).*'); }
    // 태그: 10개까지, 각 1~12자, 줄바꿈 금지
    function tagsOk(t) {
      return t is list && t.size() <= 10
        && (t.size() == 0 || (t.join('\n').matches('^[^\n]{1,12}(\n[^\n]{1,12})*$') && t.join('\n').split('\n').size() == t.size()))
        && (t.size() <= 0 || t[0] is string) && (t.size() <= 1 || t[1] is string) && (t.size() <= 2 || t[2] is string)
        && (t.size() <= 3 || t[3] is string) && (t.size() <= 4 || t[4] is string) && (t.size() <= 5 || t[5] is string)
        && (t.size() <= 6 || t[6] is string) && (t.size() <= 7 || t[7] is string) && (t.size() <= 8 || t[8] is string)
        && (t.size() <= 9 || t[9] is string);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && d().keys().hasOnly(['displayName', 'className', 'schoolYear', 'classSize', 'theme', 'periodStart',
                               'migratedAt', 'migrationVersion', 'createdAt', 'updatedAt'])
        && optStr('displayName', 40) && optStr('className', 30)
        && optInt('schoolYear', 2024, 2099) && optInt('classSize', 0, 50)
        && (!('theme' in d()) || d().theme in ['system', 'light', 'dark'])
        && (!('periodStart' in d()) || hm(d().periodStart))
        && optTs('migratedAt') && optInt('migrationVersion', 1, 100)
        && optTs('createdAt') && optTs('updatedAt');

      // 학생: 번호·이름만 필수. 생일은 연도 없이 MM-DD (생일 축하용, 개인정보 최소화)
      match /students/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(sid)
          && d().keys().hasAll(['no', 'name'])
          && d().keys().hasOnly(['no', 'name', 'sex', 'birthday', 'active', 'memo', 'createdAt', 'updatedAt'])
          && d().no is int && d().no >= 1 && d().no <= 50
          && str(d().name, 1, 20)
          && (!('sex' in d()) || d().sex in ['m', 'f', ''])
          && (!('birthday' in d()) || (d().birthday is string && d().birthday.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
          && optBool('active') && optStr('memo', 200) && (!('memo' in d()) || safeText(d().memo))
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 출결: 예외만 저장(문서 없음 = 출석). 문서 id = 날짜_학생id
      match /attendance/{aid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && aid.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]_[A-Za-z0-9_-]{1,40}$')
          && d().keys().hasAll(['date', 'sid', 'status'])
          && d().keys().hasOnly(['date', 'sid', 'status', 'reason', 'period', 'paper', 'note', 'updatedAt'])
          && ymd(d().date) && id(d().sid) && aid == d().date + '_' + d().sid
          && d().status in ['absent', 'late', 'early', 'out']
          && (!('reason' in d()) || d().reason in ['sick', 'unexcused', 'approved', 'other'])
          && optInt('period', 1, 8) && optBool('paper')
          && optStr('note', 100) && (!('note' in d()) || safeText(d().note))
          && optTs('updatedAt');
      }

      // 관찰·상담·보호자·칭찬 기록
      match /records/{rid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(rid)
          && d().keys().hasAll(['date', 'kind', 'text'])
          && d().keys().hasOnly(['date', 'kind', 'sid', 'text', 'tags', 'neis', 'follow', 'minutes', 'source', 'createdAt', 'updatedAt'])
          && ymd(d().date) && d().kind in ['observe', 'counsel', 'parent', 'praise']
          && (!('sid' in d()) || id(d().sid))
          && str(d().text, 1, 2000) && safeText(d().text)
          && (!('tags' in d()) || tagsOk(d().tags))
          && optBool('neis') && (!('follow' in d()) || ymd(d().follow))
          && optInt('minutes', 0, 600)
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 학급 일정
      match /events/{eid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(eid)
          && d().keys().hasAll(['date', 'title'])
          && d().keys().hasOnly(['date', 'end', 'time', 'title', 'kind', 'memo', 'source', 'createdAt', 'updatedAt'])
          && ymd(d().date) && (!('end' in d()) || (ymd(d().end) && d().end >= d().date))
          && (!('time' in d()) || hm(d().time))
          && str(d().title, 1, 60) && safeText(d().title)
          && (!('kind' in d()) || d().kind in ['class', 'school', 'holiday', 'mine'])
          && optStr('memo', 300) && (!('memo' in d()) || safeText(d().memo))
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 할 일 (걷기 진행: got / of)
      match /todos/{tid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(tid)
          && d().keys().hasAll(['title', 'done'])
          && d().keys().hasOnly(['title', 'done', 'due', 'got', 'of', 'order', 'source', 'createdAt', 'updatedAt', 'doneAt'])
          && str(d().title, 1, 100) && safeText(d().title) && d().done is bool
          && (!('due' in d()) || ymd(d().due))
          && optInt('got', 0, 50) && optInt('of', 0, 50) && optInt('order', 0, 100000)
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt') && optTs('doneAt');
      }

      // 메모
      match /notes/{nid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && id(nid)
          && d().keys().hasAll(['text'])
          && d().keys().hasOnly(['text', 'date', 'tags', 'pinned', 'source', 'createdAt', 'updatedAt'])
          && str(d().text, 1, 2000) && safeText(d().text)
          && (!('date' in d()) || ymd(d().date)) && (!('tags' in d()) || tagsOk(d().tags))
          && optBool('pinned')
          && (!('source' in d()) || d().source in ['app', 'legacy', 'file'])
          && optTs('createdAt') && optTs('updatedAt');
      }

      // 알림장: 문서 id = 날짜
      match /notices/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && ymd(day)
          && d().keys().hasAll(['text'])
          && d().keys().hasOnly(['text', 'copiedAt', 'updatedAt'])
          && str(d().text, 0, 2000) && safeText(d().text)
          && optTs('copiedAt') && optTs('updatedAt');
      }

      // 시간표: 문서 id = 요일 mon~fri (기본표) 또는 날짜(그날만 바뀐 표)
      match /timetable/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (key in ['mon', 'tue', 'wed', 'thu', 'fri'] || ymd(key))
          && d().keys().hasOnly(['p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8',
                                 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 'updatedAt'])
          && optStr('p1', 20) && optStr('p2', 20) && optStr('p3', 20) && optStr('p4', 20)
          && optStr('p5', 20) && optStr('p6', 20) && optStr('p7', 20) && optStr('p8', 20)
          && optStr('s1', 20) && optStr('s2', 20) && optStr('s3', 20) && optStr('s4', 20)
          && optStr('s5', 20) && optStr('s6', 20) && optStr('s7', 20) && optStr('s8', 20)
          && optTs('updatedAt');
      }

      // 예전 교무수첩에서 새 구조로 못 옮긴 쪽을 글 그대로 보관(읽기 전용 보관함). 민감 쪽은 여기 오지 않음
      match /legacy/{lid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && lid.matches('^(p[0-9]{1,3}|list-[A-Za-z]{1,30}|board-[A-Za-z]{1,30})$')
          && d().keys().hasAll(['kind', 'raw', 'at'])
          && d().keys().hasOnly(['kind', 'raw', 'title', 'at'])
          && str(d().kind, 1, 30) && str(d().raw, 2, 200000) && safeText(d().raw)
          && optStr('title', 60) && d().at is timestamp;
        allow update: if false; // 보관본은 고치지 않음
      }

      // 옮기기·가져오기 이력: 몇 건을 언제 어디서 옮겼는지만
      match /imports/{iid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && iid.matches('^imp-[0-9a-z]{6,14}$')
          && d().keys().hasAll(['from', 'count', 'at'])
          && d().keys().hasOnly(['from', 'count', 'skipped', 'localOnly', 'at'])
          && d().from in ['legacy-local', 'legacy-cloud', 'json']
          && d().count is int && d().count >= 0 && d().count <= 50000
          && optInt('skipped', 0, 50000) && optInt('localOnly', 0, 50000)
          && d().at is timestamp;
        allow update: if false;
      }
      // 그 밖의 하위 컬렉션: 규칙 없음 = 거부
    }
    // users 밖 모든 경로: 규칙 없음 = 거부
  }
}
